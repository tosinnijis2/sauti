generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?   @unique
  passwordHash String
  location     String?
  imageUrl     String?
  role         Role      @default(USER)
  listings     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  item        String
  category    String
  price       Decimal  @db.Decimal(12, 2)
  location    String
  description String
  imageUrl    String?
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([location])
  @@index([ownerId])
}

enum Role {
  USER
  ADMIN
}
